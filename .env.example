# Copy to .env and edit. Every value below is the built-in default,
# so the service runs with no .env file at all.

# --- storage -----------------------------------------------------------
# Any SQLAlchemy URL. SQLite is the default so the repo runs with no server.
DATABASE_URL=sqlite:///./exchange_rate.db

# --- rate source -------------------------------------------------------
# ecb    = live European Central Bank daily reference rates (needs network)
# static = a fixed built-in snapshot, for offline runs, demos and tests
RATES_PROVIDER=ecb
ECB_URL=https://www.ecb.europa.eu/stats/eurofxref/eurofxref-daily.xml
HTTP_TIMEOUT_SECONDS=10.0

# --- background ingest -------------------------------------------------
SCHEDULER_ENABLED=true
INGEST_HOUR=0
INGEST_MINUTE=2

# --- pagination --------------------------------------------------------
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200

# --- natural-language conversion (/v1/convert/ask) ---------------------
# rules     = deterministic offline parser (default, no API key, no network)
# anthropic = Claude, with an automatic fall back to `rules` on any error
NLQ_PROVIDER=rules
ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=sk-ant-...
